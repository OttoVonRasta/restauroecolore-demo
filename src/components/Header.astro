---
import { Image } from 'astro:assets';
import { azienda, menu } from '../data/sito';
import { foto } from '../lib/foto';

const qui = Astro.url.pathname;
---

<header class="testata">
  <div class="contenitore testata__riga">
    <a href="/" class="testata__logo" aria-label={`${azienda.nome}, pagina iniziale`}>
      <Image src={foto('2016/09/logo.png')} alt={azienda.nome} loading="eager" />
    </a>
    <nav class="testata__menu" id="menu-principale" aria-label="Menu principale">
      <ul role="list">
        {
          menu.map((voce) => (
            <li>
              <a href={voce.href} aria-current={qui.startsWith(voce.href) ? 'page' : undefined}>
                {voce.titolo}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <a class="bottone testata__telefono" href={`tel:${azienda.telefonoLink}`}>
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M3 5a2 2 0 0 1 2-2h2.6a1 1 0 0 1 1 .8l.9 4a1 1 0 0 1-.5 1.1L7.2 10a13 13 0 0 0 6.8 6.8l1.1-1.8a1 1 0 0 1 1.1-.5l4 .9a1 1 0 0 1 .8 1V19a2 2 0 0 1-2 2A16 16 0 0 1 3 5Z"
        ></path>
      </svg>
      {azienda.telefono}
    </a>
    <button
      type="button"
      class="testata__toggle"
      aria-label="Apri il menu"
      aria-expanded="false"
      aria-controls="menu-principale"
    >
      <span></span><span></span><span></span>
    </button>
  </div>
</header>

<script>
  const testata = document.querySelector<HTMLElement>('.testata');
  const toggle = document.querySelector<HTMLButtonElement>('.testata__toggle');
  const imposta = (aperto: boolean) => {
    testata?.classList.toggle('testata--aperta', aperto);
    toggle?.setAttribute('aria-expanded', String(aperto));
    toggle?.setAttribute('aria-label', aperto ? 'Chiudi il menu' : 'Apri il menu');
  };
  toggle?.addEventListener('click', () => imposta(!testata?.classList.contains('testata--aperta')));
  document.querySelectorAll('#menu-principale a').forEach((a) => a.addEventListener('click', () => imposta(false)));
  document.addEventListener('keydown', (e) => e.key === 'Escape' && imposta(false));
</script>

<style>
  .testata {
    position: sticky;
    top: 0;
    z-index: 20;
    background: rgb(255 255 255 / 0.94);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--linea);
  }

  .testata__riga {
    display: flex;
    align-items: center;
    gap: 2rem;
    min-height: 5rem;
  }

  .testata__logo img {
    width: auto;
    height: 3.5rem;
  }

  .testata__menu {
    margin-left: auto;
  }

  .testata__menu ul {
    display: flex;
    gap: clamp(1rem, 2.2vw, 2.2rem);
  }

  .testata__menu a {
    position: relative;
    padding-block: 0.5rem;
    font-weight: 600;
    text-decoration: none;
    color: var(--inchiostro);
  }

  .testata__menu a::after {
    content: '';
    position: absolute;
    inset: auto 0 0;
    height: 2px;
    background: var(--verde);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.2s;
  }

  .testata__menu a:hover::after,
  .testata__menu a[aria-current='page']::after {
    transform: scaleX(1);
  }

  .testata__telefono {
    padding: 0.7rem 1.2rem;
    white-space: nowrap;
  }

  .testata__toggle {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 2.75rem;
    height: 2.75rem;
    padding: 0.6rem;
    border: 1px solid var(--linea);
    border-radius: 0.5rem;
    background: transparent;
    cursor: pointer;
  }

  .testata__toggle span {
    display: block;
    height: 2px;
    background: var(--inchiostro);
    transition: transform 0.2s, opacity 0.2s;
  }

  .testata--aperta .testata__toggle span:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }

  .testata--aperta .testata__toggle span:nth-child(2) {
    opacity: 0;
  }

  .testata--aperta .testata__toggle span:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  @media (max-width: 900px) {
    .testata__riga {
      gap: 0.75rem;
    }

    .testata__toggle {
      display: flex;
    }

    .testata__telefono {
      margin-left: auto;
    }

    .testata__menu {
      display: none;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      margin: 0;
      padding: 0.5rem 1.25rem 1rem;
      background: #fff;
      border-bottom: 1px solid var(--linea);
      box-shadow: 0 12px 24px rgb(0 0 0 / 0.08);
    }

    .testata--aperta .testata__menu {
      display: block;
    }

    .testata__menu ul {
      flex-direction: column;
      gap: 0;
    }

    .testata__menu a {
      display: block;
      padding-block: 0.9rem;
      border-bottom: 1px solid var(--linea);
    }

    .testata__menu a::after {
      display: none;
    }
  }

  @media (max-width: 480px) {
    .testata__telefono {
      padding: 0.7rem;
      font-size: 0;
      gap: 0;
    }
  }
</style>
