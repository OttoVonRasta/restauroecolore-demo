---
import '@fontsource-variable/fraunces';
import '@fontsource-variable/figtree';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { azienda } from '../data/sito';

interface Props {
  titolo?: string;
  descrizione?: string;
}

const {
  titolo,
  descrizione = `${azienda.nome}: dal ${azienda.annoFondazione} restauri conservativi di immobili nel Nordest. Tinteggiature, ponteggi, tetti, isolamenti, pavimentazioni e interni.`,
} = Astro.props;
const titoloPagina = titolo ? `${titolo} | ${azienda.nome}` : `${azienda.nome} | Restauri conservativi di immobili`;
const canonico = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="it">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titoloPagina}</title>
    <meta name="description" content={descrizione} />
    <link rel="canonical" href={canonico} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="it_IT" />
    <meta property="og:site_name" content={azienda.nome} />
    <meta property="og:title" content={titoloPagina} />
    <meta property="og:description" content={descrizione} />
    <meta property="og:url" content={canonico} />
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
